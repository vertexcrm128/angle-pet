# ==========================================
#  Angel PET — Root .gitignore
# ==========================================

# ── Environment / Secrets (NEVER commit these) ──
.env
.env.*
!.env.example

# ── Firebase service account key (contains private keys) ──
serviceAccountKey.json
*serviceAccount*.json
firebase-credentials.json

# ── Node modules ──
node_modules/
**/node_modules/

# ── Build output ──
dist/
dist-ssr/
build/

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / Editor ──
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.idea/
.vscode/*
!.vscode/extensions.json

# ── Misc ──
*.local
.cache/
coverage/
